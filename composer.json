{
    "name": "goaop/virtual-file-system",
    "description": "Blazing-fast in-memory virtual filesystem for PHP 8.4+ — a modern, fully-typed replacement for adlawson/vfs with zero deprecations, full stream wrapper coverage, permissions, symlinks, locks and quotas.",
    "type": "library",
    "keywords": [
        "vfs",
        "virtual",
        "filesystem",
        "file",
        "system",
        "mock",
        "testing",
        "stream",
        "wrapper",
        "in-memory"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Lisachenko Alexander",
            "email": "lisachenko.it@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.2",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Go\\VirtualFileSystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Go\\VirtualFileSystem\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
